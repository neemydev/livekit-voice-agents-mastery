# Copy this file to .env and fill in your own keys.
# .env is ignored by git, so your real keys are never published.

# LiveKit server.
# Local server in Docker (docker compose up -d) - public dev values, local use only:
#   LIVEKIT_URL=ws://localhost:7880   LIVEKIT_API_KEY=devkey   LIVEKIT_API_SECRET=secret
# Or a LiveKit Cloud project (https://cloud.livekit.io) - use your own project's values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
