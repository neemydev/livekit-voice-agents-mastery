# Copy this file to .env and fill in your own keys.
# .env is ignored by git, so your real keys are never published.

# LiveKit server.
# Put your LiveKit CLOUD project's values here (https://cloud.livekit.io).
# They are used by Cloud mode:  docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d
# The LOCAL server values (ws://127.0.0.1:7880, devkey, secret) are already set in
# docker-compose.yml, so local mode works even if these three lines stay empty.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
